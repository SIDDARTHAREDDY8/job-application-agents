# Copy to .env and fill in. The agents read ONLY these variables to connect an LLM.
# Pick ONE provider and set its key. See README for the full table.

# Which LLM drives the agents: openai | anthropic | gemini | ollama | openrouter | groq | together | deepseek | mistral | lmstudio | custom
LLM_PROVIDER=openai

# Model name (optional - each provider has a sane default)
# LLM_MODEL=gpt-4o-mini

# API key for the provider (not needed for ollama / lmstudio)
LLM_API_KEY=sk-...

# Only needed for provider=custom, or to override a default endpoint
# LLM_BASE_URL=https://your-endpoint/v1

# Optional tuning
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2000
