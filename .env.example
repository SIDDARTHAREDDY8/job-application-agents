# Copy to .env and fill in. The agents read ONLY these variables.

# ============ LLM (pick one provider) ============
# openai | anthropic | gemini | ollama | openrouter | groq | together | deepseek | mistral | lmstudio | custom
LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...
# LLM_BASE_URL=https://your-endpoint/v1   # only for provider=custom, or to override a default
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2000

# ============ Gmail (for the email-apply route) ============
# mode: smtp (app password, simplest) | api (OAuth, needs Google Cloud credentials)
GMAIL_MODE=smtp
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx   # Google Account -> Security -> App passwords
# For api mode instead:
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# ============ Browser (for the board-apply route) ============
# Nothing to configure: sessions persist in state/browser_profile/.
# Run once with --headed, log in to each board manually, close the browser.

# ============ MCP servers (optional: plug any MCP server into the agents) ============
# JSON map of name -> server config. Examples:
# MCP_SERVERS={"playwright": {"command": "npx", "args": ["-y", "@playwright/mcp@latest"]}}
# MCP_SERVERS={"mytools": {"url": "http://localhost:8000/sse"}}
